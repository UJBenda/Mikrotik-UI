[Unit]
Description=MikroTik Controller – šifrovaná záloha (DB, konfigurace, klíče)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
# root: pg_dump jako postgres (RLS je FORCE i pro vlastníka), čte master.key a heslo záloh
Environment=MTC_CONFIG=/etc/mtcontroller/config.toml
Environment=PYTHONPATH=/opt/mtcontroller/app
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m mtcontroller.cli backup --scheduled
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
