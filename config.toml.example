# Kopírovat do /etc/mtcontroller/config.toml (root:mtcontroller, 0640).
# Každou hodnotu lze přepsat proměnnou prostředí MTC_<SEKCE>__<KLÍČ>,
# např. MTC_DATABASE__DSN.

[database]
# Aplikace se připojuje rolí bez BYPASSRLS (viz docs/install.md).
dsn = "postgresql+psycopg://mtc_app@/mtcontroller?host=/run/postgresql"
# Role vlastnící schéma, používá ji jen `alembic upgrade`.
migrate_dsn = "postgresql+psycopg://mtc_owner@/mtcontroller?host=/run/postgresql"

[web]
# nginx terminuje TLS a proxuje na localhost.
listen_host = "127.0.0.1"
listen_port = 8080
# Hostname admin UI (dostupné jen z admin sítě / VPN).
ui_host = "mtc-admin.example.cz"
# Hostname pro check-in a adopci (z internetu).
checkin_host = "mtc-checkin.example.cz"

[security]
# 32 bajtů náhodných dat (base64), soubor 0640 root:mtcontroller.
master_key_file = "/etc/mtcontroller/master.key"
adoption_token_ttl_minutes = 60

[paths]
data_dir = "/var/lib/mtcontroller"

[tunnel]
# Provider tunelů: "mikrotik" (fyzický koncentrátor) nebo později "radius".
provider = "mikrotik"
pool = "10.200.0.0/16"
tenant_block_prefix = 24
# Hostname, na které míří SSTP klienti. Druhý je záloha.
concentrator_hosts = ["vpn1.example.cz", "vpn2.example.cz"]
# Management adresa koncentrátoru, kam controller volá REST API.
concentrator_api = "https://10.10.0.1"
