    "script": "# NAHLED migrace VLAN - vygenerovano controllerem, NESPOUSTET bez kontroly\n# Doporuceni: provadet z konzole/MAC-Winboxu, ne pres sit, ktera se prave meni.\n{\n/interface bridge port set [find interface=\"ether1\"] bridge=\"bridge\" pvid=1\n/interface bridge port set [find interface=\"ether2\"] bridge=\"bridge\" pvid=1\n/interface bridge port set [find interface=\"ether3\"] bridge=\"bridge\" pvid=10\n/interface bridge port set [find interface=\"ether4\"] bridge=\"bridge\" pvid=20\n/interface bridge vlan add bridge=\"bridge\" vlan-ids=10 tagged=\"bridge,ether1\" untagged=\"ether3\" comment=\"mtc: migrace VLAN\"\n/interface bridge vlan add bridge=\"bridge\" vlan-ids=20 tagged=\"bridge,ether1\" untagged=\"ether4\" comment=\"mtc: migrace VLAN\"\n/interface vlan add name=\"vlan10\" interface=\"bridge\" vlan-id=10 comment=\"mtc: migrace VLAN\"\n/ip address set [find address=\"10.0.10.1/24\" interface=\"br-vlan10\"] interface=\"vlan10\"\n/ip dhcp-server set [find name=\"dhcp-v10\"] interface=\"vlan10\"\n/interface vlan add name=\"vlan20\" interface=\"bridge\" vlan-id=20 comment=\"mtc: migrace VLAN\"\n/interface bridge port remove [find interface=\"vlan10-e1\"]\n/interface vlan remove [find name=\"vlan10-e1\"]\n/interface bridge port remove [find interface=\"vlan20-e1\"]\n/interface vlan remove [find name=\"vlan20-e1\"]\n/interface bridge remove [find name=\"br-vlan10\"]\n/interface bridge remove [find name=\"br-vlan20\"]\n/interface bridge set [find name=\"bridge\"] vlan-filtering=yes\n}\n",
    "blockers": [],
