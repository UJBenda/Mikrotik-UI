#!/bin/sh
# Instalace / aktualizace balíčku. První instalace spustí webového průvodce (mtc-setup);
# aktualizace jen pustí migrace a restartuje služby.
set -e

ETC=/etc/mtcontroller
DATA=/var/lib/mtcontroller
MTC_ADMIN=/usr/sbin/mtc-admin
. /usr/share/mtcontroller/common.sh

case "$1" in
  configure) ;;
  *) exit 0 ;;
esac

mtc_user_dirs
install -d -o mtcontroller -g mtcontroller -m 0750 "$DATA/setup"
install -d -o root -g mtcontroller -m 0750 /var/backups/mtcontroller
mtc_master_key
# PostgreSQL po čerstvé instalaci teprve startuje
systemctl start postgresql >/dev/null 2>&1 || true
mtc_postgres
"$MTC_ADMIN" migrate
mtc_sysctl
systemctl daemon-reload

if [ -f "$ETC/config.toml" ]; then
  # aktualizace nastaveného controlleru
  # heslo záloh (starší instalace ho ještě nemají)
  if [ ! -f "$ETC/backup.key" ]; then
    (umask 077; python3 -c 'import sys; sys.path.insert(0, "/opt/mtcontroller/app"); from mtcontroller.sysbackup import new_passphrase; print(new_passphrase())' > "$ETC/backup.key")
    echo "vytvořeno heslo záloh – zobrazí ho: sudo mtc-admin recovery-kit"
  fi
  # certifikáty HTTPS ve slotech (starší verze je měly jinde); nginx musí naběhnout vždy
  mtc_tls_hook
  "$MTC_ADMIN" tls bootstrap || echo "!! certifikáty: mtc-admin tls bootstrap selhal" >&2
  systemctl enable mtc-web mtc-worker mtc-syslog mtc-backup.timer mtc-backup.path mtc-tls.path >/dev/null
  systemctl restart mtc-web mtc-worker mtc-syslog
  systemctl start mtc-backup.path mtc-tls.path
  systemctl restart mtc-backup.timer  # plán záloh: timer co 15 min (starší verze měla denně)
  systemctl reload nginx 2>/dev/null || true
  exit 0
fi

# --- první spuštění: průvodce -----------------------------------------------------------
if [ ! -f "$ETC/setup-code" ]; then
  (umask 027; python3 -c 'import sys; sys.path.insert(0, "/opt/mtcontroller/app"); from mtcontroller.firstrun import new_code; print(new_code())' > "$ETC/setup-code")
fi
chown root:mtcontroller "$ETC/setup-code"
chmod 0640 "$ETC/setup-code"

mtc_tls_hook
# průvodce běží na dočasném self-signed certifikátu (bez DNS a internetu); certifikáty controlleru
# vydá průvodce: vždy z CA controlleru, Let's Encrypt jen navíc (když selže, instalace pokračuje)
if [ ! -f /etc/ssl/mtc/setup.crt ]; then
  openssl req -x509 -newkey rsa:2048 -nodes -days 30 -subj "/CN=mtcontroller-setup" \
    -keyout /etc/ssl/mtc/setup.key -out /etc/ssl/mtc/setup.crt 2>/dev/null
  chmod 0600 /etc/ssl/mtc/setup.key
fi
install -m 0644 /usr/share/mtcontroller/nginx/mtcontroller-setup.conf /etc/nginx/sites-available/mtcontroller-setup.conf
ln -sfn /etc/nginx/sites-available/mtcontroller-setup.conf /etc/nginx/sites-enabled/mtcontroller-setup.conf
rm -f /etc/nginx/sites-enabled/default
install -d -m 0755 /var/www/html
nginx -t >/dev/null 2>&1 && (systemctl reload nginx 2>/dev/null || systemctl restart nginx) || \
  echo "!! nginx -t selhal – zkontroluj /etc/nginx/sites-enabled" >&2

systemctl enable --now mtc-setup.service mtc-setup-apply.path >/dev/null

IP=$(ip -4 route get 192.0.2.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')
cat <<MSG

==================================================================
 MikroTik Controller je nainstalovaný. Dokonči nastavení v prohlížeči:

     https://${IP:-<IP serveru>}/

 Kód průvodce:  $(cat "$ETC/setup-code")
 (znovu ho vypíše: sudo mtc-admin setup-code)
==================================================================

MSG
exit 0
